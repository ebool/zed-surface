<!--
  Go-to-definition test:
  Command-click an identifier below on macOS, or run Zed's
  `editor: go to definition` action.
-->
<section id={@id} :attrs={@rest}>
  <h1>{format_label(@title)}</h1>

  <NavigationDemo.card title={@title} />
  <.badge label={@title} />

  <ul>
    <li :for={item <- @items}>{item.name}</li>
  </ul>
</section>
